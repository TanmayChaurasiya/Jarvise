# =========================================
# JARVIS Environment Configuration
# =========================================
# Copy this file to .env and fill in values

# --- AI Providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/jarvis
MONGODB_DB_NAME=jarvis

# --- Backend Server ---
BACKEND_PORT=3001
BACKEND_HOST=localhost

# --- Security ---
IPC_SECRET=
SESSION_SECRET=

# --- Voice ---
WAKE_WORD=hey jarvis
VOICE_LANGUAGE=en-US

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=jarvis.log
